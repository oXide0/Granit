---
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';

interface Props {
  title: string;
  description: string;
  /** Шлях до OG-зображення в /public */
  ogImage?: string;
}

const { title, description, ogImage = '/og-image.jpg' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Структуровані дані для пошуковиків (локальний бізнес).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description,
  url: canonical,
  image: ogImageUrl,
  telephone: site.phone.plain,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.locality,
    addressLocality: site.address.district,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  areaServed: {
    '@type': 'Country',
    name: 'Україна',
  },
};
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#16181b" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Виробництво виробів з природного каменю" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <!--
      TODO (аналітика): сюди підключити Google Analytics / Google Tag Manager,
      коли замовник підтвердить, що це потрібно. Приклад:
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXX"></script>
    -->
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до основного вмісту</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />

    <style>
      .skip-link {
        position: absolute;
        left: 0.5rem;
        top: -100px;
        z-index: 100;
        padding: 0.75rem 1rem;
        background: var(--c-ink);
        color: var(--c-white);
        border-radius: var(--radius);
        text-decoration: none;
      }
      .skip-link:focus {
        top: 0.5rem;
      }
    </style>
  </body>
</html>
