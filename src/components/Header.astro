---
import { site, nav } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
---

<header class="header">
  <div class="container header__inner">
    <Logo />

    <nav class="header__nav" aria-label="Основна навігація">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="header__phone" href={site.phone.href}>
      <Icon name="phone" size={18} />
      <span>{site.phone.display}</span>
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 250, 248, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 68px;
  }

  /* Навігація з'являється лише коли рядок «логотип + меню + телефон»
     справді вміщається в один рядок (~1040px). Раніше на 860–1040px
     пункти меню й логотип рвалися на два рядки, а кнопка телефону
     виїжджала за край екрана. */
  .header__nav {
    display: none;
    margin-inline-start: auto;
  }

  .header__nav ul {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }

  .header__nav a {
    display: block;
    white-space: nowrap;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-text-muted);
    padding-block: 0.5rem;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .header__nav a:hover {
    color: var(--c-ink);
    border-bottom-color: var(--c-accent);
  }

  .header__phone {
    display: none;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border: 2px solid var(--c-ink);
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .header__phone:hover {
    background: var(--c-ink);
    color: var(--c-white);
  }

  /* Телефон у шапці вмикаємо рано — щойно поруч з логотипом стає місце.
     На вужчих екранах номер лишається доступним у липкій панелі знизу. */
  @media (min-width: 560px) {
    .header__phone {
      display: inline-flex;
    }
  }

  @media (min-width: 1040px) {
    .header__nav {
      display: block;
    }
  }
</style>
