---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ProductCategory } from '../data/products';

interface Props {
  product: ProductCategory;
  image?: ImageMetadata;
}

const { product, image } = Astro.props;

// The products section starts ~1500px down the page — it is below the fold on
// every screen size, so every card loads lazily. Loading them eagerly would
// compete for bandwidth with the hero image, which is the LCP element.
---

<li class="card">
  <div class="card__media">
    {
      image ? (
        <Image
          src={image}
          alt={product.alt}
          widths={[400, 700]}
          sizes="(min-width: 1000px) 360px, (min-width: 620px) 45vw, 90vw"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="card__placeholder">
          <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
            <path
              d="M20 4 36 12v16L20 36 4 28V12L20 4Z"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"
            />
            <path d="M4 12 20 20l16-8M20 20v16" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
          <span>Фото: {product.title}</span>
        </div>
      )
    }
  </div>

  <div class="card__body">
    <h3>{product.title}</h3>
    <p>{product.description}</p>
  </div>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--c-white);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .card__media {
    aspect-ratio: 4 / 3;
    background: var(--c-sand-200);
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Placeholder shown until a real photo exists — see README for how to add one */
  .card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem;
    text-align: center;
    color: var(--c-stone);
    background:
      repeating-linear-gradient(
        135deg,
        var(--c-sand-200) 0 12px,
        var(--c-sand-100) 12px 24px
      );
  }

  .card__placeholder span {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .card__body {
    padding: 1.25rem 1.35rem 1.5rem;
  }

  .card__body h3 {
    margin-bottom: 0.4rem;
  }

  .card__body p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--c-text-muted);
  }
</style>
