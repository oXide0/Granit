---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '~/components/Icon.astro';

interface Props {
	title: string;
	image: ImageMetadata;
	alt: string;
	loading?: 'eager' | 'lazy';
}

const { title, image, alt, loading = 'lazy' } = Astro.props;
---

<!-- The whole card is one link target: bigger hit area, one tab stop. -->
<article class="group relative bg-surface ring-1 ring-line transition-shadow duration-300 hover:shadow-[0_18px_40px_-24px_rgb(20_20_15/0.45)]">
	<div class="overflow-hidden">
		<Image
			src={image}
			alt={alt}
			widths={[320, 480, 640]}
			sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 24vw"
			loading={loading}
			decoding={loading === 'eager' ? 'sync' : 'async'}
			class="aspect-4/3 w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
		/>
	</div>

	<div class="flex items-center justify-between gap-3 border-t border-line px-5 py-4">
		<h3 class="text-h3 font-bold text-balance">
			<a href="/catalog" class="after:absolute after:inset-0 after:content-['']">
				{title}
			</a>
		</h3>
		<Icon
			name="arrow-up-right"
			class="h-5 w-5 shrink-0 text-ink-faint transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-brass"
		/>
	</div>
</article>
