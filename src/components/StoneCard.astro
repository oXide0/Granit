---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	title: string;
	image: ImageMetadata;
	alt: string;
	description?: string;
	index: number;
	loading?: 'eager' | 'lazy';
}

const { title, image, alt, description, index, loading = 'lazy' } = Astro.props;
---

<li class="group flex flex-col bg-surface ring-1 ring-line transition-shadow duration-300 hover:shadow-[0_18px_40px_-24px_rgb(20_20_15/0.45)]">
	<div class="relative overflow-hidden">
		<Image
			src={image}
			alt={alt}
			widths={[320, 640]}
			sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw"
			loading={loading}
			decoding={loading === 'eager' ? 'sync' : 'async'}
			class="aspect-4/3 w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
		/>
		<span
			class="absolute top-0 left-0 bg-paper px-3 py-1.5 text-xs font-bold tracking-[0.18em] text-ink-muted"
		>
			0{index + 1}
		</span>
	</div>

	<div class="flex flex-1 flex-col border-t border-line p-6">
		<h2 class="text-h3 font-bold text-balance">{title}</h2>
		{
			description && (
				<p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-muted text-pretty">{description}</p>
			)
		}
	</div>
</li>
