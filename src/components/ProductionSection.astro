---
import { Image } from 'astro:assets';
import { PRODUCTION_PHOTOS } from '~/data/production';

const [lead, ...rest] = PRODUCTION_PHOTOS;
---

<section id="production" class="container-page py-20 md:py-28 lg:py-36">
	<div class="max-w-2xl">
		<p class="eyebrow">Виробництво</p>
		<h2 class="mt-5 text-h2 font-bold text-balance">Наш цех на Житомирщині</h2>
		<p class="mt-5 text-lead text-ink-muted text-pretty">
			Розпил, обробка та полірування відбуваються на власному обладнанні — тому ми
			відповідаємо за якість кожного виробу й тримаємо для Житомира ціну без націнки
			посередників.
		</p>
	</div>

	<!-- A static gallery instead of a carousel: every photo is visible at once,
	     nothing auto-rotates away from the reader, and it costs no JavaScript. -->
	<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4 lg:grid-rows-2">
		<figure class="lg:col-span-2 lg:row-span-2">
			<Image
				src={lead.image}
				alt={lead.alt}
				widths={[640, 960, 1280]}
				sizes="(max-width: 768px) 92vw, (max-width: 1024px) 46vw, 46vw"
				loading="lazy"
				class="h-full min-h-64 w-full object-cover md:aspect-square lg:aspect-auto"
			/>
		</figure>

		{
			/* The first of the remaining three spans two columns so the 4x2 grid
			   fills exactly, with no empty cell. */
			rest.map((photo, index) => (
				<figure class={index === 0 ? 'lg:col-span-2' : 'lg:col-span-1'}>
					<Image
						src={photo.image}
						alt={photo.alt}
						widths={[400, 800]}
						sizes={index === 0 ? '(max-width: 768px) 92vw, 46vw' : '(max-width: 768px) 92vw, 23vw'}
						loading="lazy"
						class="aspect-4/3 w-full object-cover"
					/>
				</figure>
			))
		}
	</div>
</section>
