---
import { Image } from 'astro:assets';
import contactImg from '~/assets/img/contact_img.jpg';
import Icon from '~/components/Icon.astro';
import { CONTACTS } from '~/data/site';

const channels = [
	{
		icon: 'phone' as const,
		label: 'Телефон',
		value: CONTACTS.phone,
		href: CONTACTS.phoneHref,
		action: 'Подзвонити',
	},
	{
		icon: 'mail' as const,
		label: 'Email',
		value: CONTACTS.email,
		href: CONTACTS.emailHref,
		action: 'Написати',
	},
	{
		icon: 'pin' as const,
		label: 'Адреса',
		value: CONTACTS.address.short,
		href: CONTACTS.mapUrl,
		action: 'На карті',
		external: true,
	},
];
---

<section id="contacts" class="bg-ink text-paper">
	<div class="container-page py-20 md:py-28 lg:py-32">
		<div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
			<div class="lg:col-span-7">
				<p class="eyebrow text-brass-soft">Контакти</p>
				<h2 class="mt-5 text-h2 font-bold text-balance">Кортить почати?</h2>
				<p class="mt-5 max-w-lg text-lead text-paper/65 text-pretty">
					Розкажіть, який виріб і з якого каменю вам потрібен — порахуємо вартість
					і терміни. Працюємо з Житомиром і всією Житомирською областю. Ціни називаємо
					за запитом, бо вони залежать від розміру й обробки.
				</p>

				<ul class="mt-12 divide-y divide-white/10 border-y border-white/10">
					{
						channels.map((channel) => (
							<li>
								<a
									href={channel.href}
									target={channel.external ? '_blank' : undefined}
									rel={channel.external ? 'noopener noreferrer' : undefined}
									class="group flex items-center gap-5 py-5 transition-colors hover:text-brass-soft"
								>
									<span class="grid h-11 w-11 shrink-0 place-items-center border border-white/20 transition-colors group-hover:border-brass-soft">
										<Icon name={channel.icon} class="h-4.5 w-4.5" />
									</span>
									<span class="min-w-0 flex-1">
										<span class="block text-xs tracking-[0.18em] text-paper/45 uppercase">
											{channel.label}
										</span>
										{/* Wraps rather than truncates: an ellipsis would hide the
										    address on narrow screens, and `nowrap` here forced the
										    whole flex row wider than a 320px viewport. */}
										<span class="mt-1 block text-lg font-bold wrap-break-word">
											{channel.value}
										</span>
									</span>
									<span class="hidden shrink-0 items-center gap-2 text-sm font-bold sm:inline-flex">
										{channel.action}
										<Icon
											name="arrow-right"
											class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
										/>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="lg:col-span-5">
				<Image
					src={contactImg}
					alt="Гранітні балясини з різних видів каменю, виготовлені у нашому цеху"
					widths={[560, 1120]}
					sizes="(max-width: 1024px) 92vw, 38vw"
					loading="lazy"
					class="aspect-4/5 w-full object-cover opacity-90"
				/>
			</div>
		</div>
	</div>
</section>
