---
import { Image } from 'astro:assets';
import Icon from '~/components/Icon.astro';
import { TILES } from '~/data/catalog';
---

<!-- Thin band of stone swatches. Doubles as an internal link into /catalog. -->
<section class="border-y border-line bg-paper-dim">
	<div class="container-page flex flex-col gap-6 py-8 md:flex-row md:items-center md:justify-between md:py-10">
		<p class="shrink-0 text-sm font-medium text-ink-muted">Види каменю, з яким працюємо</p>

		<ul class="flex flex-1 flex-wrap items-center gap-x-8 gap-y-4 md:justify-center">
			{
				TILES.map((tile) => (
					<li>
						<a href="/catalog" class="group flex items-center gap-3">
							<Image
								src={tile.image}
								alt=""
								widths={[80, 160]}
								sizes="40px"
								loading="lazy"
								class="h-10 w-10 object-cover ring-1 ring-line-strong transition-transform duration-300 group-hover:scale-105"
							/>
							<span class="link-underline text-sm font-medium text-ink">{tile.title}</span>
						</a>
					</li>
				))
			}
		</ul>

		<a href="/catalog" class="group hidden shrink-0 items-center gap-2 text-sm font-bold text-ink lg:inline-flex">
			Каталог
			<Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
		</a>
	</div>
</section>
