---
import { ADVANTAGES } from '~/data/site';
---

<section class="border-y border-line bg-paper-dim">
	<div class="container-page py-20 md:py-28">
		<div class="max-w-2xl">
			<p class="eyebrow">Чому ми</p>
			<h2 class="mt-5 text-h2 font-bold text-balance">Камінь напряму з цеху</h2>
		</div>

		<ul class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
			{
				ADVANTAGES.map((item, index) => (
					<li class="bg-paper-dim p-7 lg:p-8">
						<span class="text-xs font-bold tracking-[0.22em] text-brass">
							0{index + 1}
						</span>
						<h3 class="mt-5 text-h3 font-bold text-balance">{item.title}</h3>
						<p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-muted text-pretty">
							{item.text}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
