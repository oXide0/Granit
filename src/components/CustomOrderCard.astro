---
/**
 * The ninth tile in the products grid.
 * Not a category, but an answer to the most common objection: "what if I need
 * something that isn't on the list?". It also rounds the grid out to an even 3x3.
 */
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<li class="custom">
  <span class="custom__icon" aria-hidden="true">
    <svg viewBox="0 0 40 40" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M20 4 36 12v16L20 36 4 28V12L20 4Z" stroke-linejoin="round" />
      <path d="M14 20h12M20 14v12" stroke-linecap="round" />
    </svg>
  </span>

  <h3>Будь-який виріб під замовлення</h3>
  <p>
    Список вище — не межа. Якщо потрібного виробу тут немає або потрібні
    нестандартні розміри чи форма — опишіть задачу по телефону, і ми скажемо,
    чи реально це зробити з каменю та скільки коштуватиме.
  </p>

  <a class="custom__cta" href={site.phone.href}>
    <Icon name="phone" size={18} />
    <span>{site.phone.display}</span>
  </a>
</li>

<style>
  .custom {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--c-ink);
    color: var(--c-sand-100);
    border: 1px solid var(--c-ink);
    border-radius: var(--radius-lg);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .custom:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .custom__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 1.1rem;
    border-radius: 50%;
    background: rgba(184, 125, 60, 0.18);
    color: #d9a460;
  }

  .custom h3 {
    margin-bottom: 0.5rem;
    color: var(--c-white);
  }

  .custom p {
    margin: 0 0 1.5rem;
    font-size: 0.9375rem;
    color: var(--c-dust);
  }

  /* button pinned to the bottom so this card lines up with the photo cards */
  .custom__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin-top: auto;
    padding: 0.85rem 1.25rem;
    min-height: 50px;
    background: var(--c-accent);
    color: var(--c-white);
    border-radius: var(--radius);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }

  .custom__cta:hover {
    background: var(--c-accent-strong);
  }

  /* In the 2-column range this card is left alone on the last row, so it
     spans the full width instead of leaving an empty cell beside it.
     Breakpoints are kept in sync with the grid in Products.astro. */
  @media (min-width: 620px) and (max-width: 999.98px) {
    .custom {
      grid-column: 1 / -1;
    }

    .custom__cta {
      align-self: flex-start;
      padding-inline: 2rem;
    }
  }
</style>
