---
/**
 * Inline SVG icons drawn with `currentColor`, so they invert correctly between
 * the paper sections and the ink footer. Replaces the white-only SVG files that
 * shipped in /public and were invisible on a light background.
 */
export type IconName = 'arrow-right' | 'arrow-up-right' | 'arrow-up' | 'phone' | 'mail' | 'pin' | 'menu' | 'close' | 'plus';

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.75"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{name === 'arrow-right' && <path d="M4 12h16m0 0-6-6m6 6-6 6" />}
	{name === 'arrow-up-right' && <path d="M7 17 17 7m0 0H8m9 0v9" />}
	{name === 'arrow-up' && <path d="M12 20V4m0 0-6 6m6-6 6 6" />}
	{
		name === 'phone' && (
			<path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 6.2 2 2 0 0 1 6 4z" />
		)
	}
	{
		name === 'mail' && (
			<>
				<rect x="3" y="5" width="18" height="14" rx="1.5" />
				<path d="m3.5 6.5 8.5 6 8.5-6" />
			</>
		)
	}
	{
		name === 'pin' && (
			<>
				<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" />
				<circle cx="12" cy="10" r="2.5" />
			</>
		)
	}
	{name === 'menu' && <path d="M3 7h18M3 12h18M3 17h18" />}
	{name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
	{name === 'plus' && <path d="M12 5v14M5 12h14" />}
</svg>
