---
import Icon from '~/components/Icon.astro';
import ProductCard from '~/components/ProductCard.astro';
import { PRODUCTS } from '~/data/products';
---

<section id="products" class="container-page py-20 md:py-28 lg:py-36">
	<div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
		<div class="max-w-2xl">
			<p class="eyebrow">Продукція</p>
			<h2 class="mt-5 text-h2 font-bold text-balance">Що ми виготовляємо з граніту</h2>
			<p class="mt-5 text-lead text-ink-muted text-pretty">
				Дванадцять категорій виробів — від памʼятників і меморіальних комплексів до
				підвіконь, стільниць і бордюрів. Виготовляємо для Житомира та області,
				кожен виріб доступний у пʼяти видах каменю.
			</p>
		</div>

		<a href="/catalog" class="group inline-flex shrink-0 items-center gap-2 text-sm font-bold text-ink">
			Види каменю
			<Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
		</a>
	</div>

	<div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
		{
			PRODUCTS.map((product, index) => (
				<ProductCard
					title={product.title}
					image={product.image}
					alt={product.alt}
					loading={index < 4 ? 'eager' : 'lazy'}
				/>
			))
		}
	</div>
</section>
