---
import Icon from '~/components/Icon.astro';
import Logo from '~/components/Logo.astro';
import { CONTACTS, NAV, SITE } from '~/data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink text-paper">
	<div class="container-page py-16 md:py-20">
		<div class="grid gap-12 md:grid-cols-12">
			<div class="md:col-span-5">
				<a href="/" aria-label={`${SITE.name} — на головну`} class="inline-block">
					<Logo variant="paper" />
				</a>
				<p class="mt-6 max-w-xs text-sm leading-relaxed text-paper/55 text-pretty">
					Виробництво та продаж виробів з натурального граніту в Житомирі та області.
					Власний цех на Житомирщині, відвантаження оптом і в роздріб.
				</p>
			</div>

			<nav class="md:col-span-3" aria-label="Навігація у підвалі">
				<h2 class="text-xs tracking-[0.18em] text-paper/45 uppercase">Розділи</h2>
				<ul class="mt-5 space-y-3">
					{
						NAV.map((item) => (
							<li>
								<a href={item.href} class="link-underline text-sm text-paper/80 hover:text-paper">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<address class="not-italic md:col-span-4">
				<h2 class="text-xs tracking-[0.18em] text-paper/45 uppercase">Контакти</h2>
				<ul class="mt-5 space-y-3 text-sm">
					<li>
						<a href={CONTACTS.phoneHref} class="link-underline font-bold text-paper">
							{CONTACTS.phone}
						</a>
					</li>
					<li>
						<a href={CONTACTS.emailHref} class="link-underline text-paper/80 hover:text-paper">
							{CONTACTS.email}
						</a>
					</li>
					<li>
						<a
							href={CONTACTS.mapUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="link-underline text-paper/80 hover:text-paper"
						>
							{CONTACTS.address.full}
						</a>
					</li>
				</ul>
			</address>
		</div>

		<div class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-xs text-paper/45">© {year}. Усі права захищено.</p>
			<a href="#main" class="group inline-flex items-center gap-2 text-xs text-paper/60 hover:text-paper">
				Нагору
				<Icon name="arrow-up" class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-1" />
			</a>
		</div>
	</div>
</footer>
