---
import { site, nav } from '../data/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo light />
      <p>{site.tagline}</p>
    </div>

    <nav class="footer__nav" aria-label="Навігація у підвалі">
      <h2>Розділи</h2>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer__contacts">
      <h2>Контакти</h2>
      <ul>
        <li><a href={site.phone.href}>{site.phone.display}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.address.short}</li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {year} {site.name}</p>
    <p class="footer__note">Доставки не здійснюємо — самовивіз з цеху.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-graphite);
    color: var(--c-sand-100);
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .footer__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .footer__brand p {
    margin: 0.9rem 0 0;
    max-width: 34ch;
    font-size: 0.9375rem;
    color: var(--c-dust);
  }

  .footer h2 {
    margin-bottom: 0.85rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-dust);
  }

  .footer ul {
    display: grid;
    gap: 0.55rem;
    font-size: 0.9375rem;
  }

  .footer a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .footer a:hover {
    border-bottom-color: var(--c-accent);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-block: 1.15rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8438rem;
    color: var(--c-dust);
  }

  .footer__bottom p {
    margin: 0;
  }

  @media (min-width: 760px) {
    .footer__inner {
      grid-template-columns: 1.6fr 1fr 1fr;
    }
  }
</style>
