---
/**
 * Placeholder logo: a faceted stone block plus the company name.
 * TODO: swap for the approved logo once the client provides it (doc.md, §2).
 */
import { site } from '../data/site';

interface Props {
  /** dark background -> light text */
  light?: boolean;
}
const { light = false } = Astro.props;
---

<a class:list={['logo', { 'logo--light': light }]} href="/" aria-label={`${site.name} — на головну`}>
  <svg class="logo__mark" width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
    <path d="M17 2 32 10.5v13L17 32 2 23.5v-13L17 2Z" fill="currentColor" opacity="0.14" />
    <path d="M17 2 32 10.5 17 19 2 10.5 17 2Z" fill="currentColor" opacity="0.55" />
    <path d="M17 19v13L2 23.5v-13L17 19Z" fill="currentColor" opacity="0.85" />
    <path
      d="M17 2 32 10.5v13L17 32 2 23.5v-13L17 2Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
  </svg>
  <span class="logo__text">
    <span class="logo__name">Кам'яні вироби</span>
    <span class="logo__sub">Житомирщина</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--c-ink);
  }

  .logo--light {
    color: var(--c-sand-100);
  }

  .logo__mark {
    flex: none;
    color: var(--c-accent);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo__name {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    /* the name must not wrap onto two lines and stretch the header */
    white-space: nowrap;
  }

  .logo__sub {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-stone);
  }

  .logo--light .logo__sub {
    color: var(--c-dust);
  }
</style>
