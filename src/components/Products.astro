---
import type { ImageMetadata } from 'astro';
import { products } from '../data/products';
import { site } from '../data/site';
import ProductCard from './ProductCard.astro';
import CustomOrderCard from './CustomOrderCard.astro';
import Icon from './Icon.astro';

/**
 * Автопідхоплення фото категорій.
 * Достатньо покласти файл з іменем = slug категорії у src/assets/products/
 * (напр. `brukivka.jpg`) — картка сама його підхопить при наступній збірці.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/products/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const imagesBySlug = new Map<string, ImageMetadata>();
for (const [path, module] of Object.entries(files)) {
  const slug = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  imagesBySlug.set(slug, module.default);
}
---

<section class="section section--tint" id="produkciya">
  <div class="container">
    <span class="eyebrow">Продукція</span>
    <h2>Що ми виготовляємо</h2>
    <p class="lead">
      Основні категорії виробів з природного каменю. Це не закритий список — якщо
      потрібного виробу тут немає, зателефонуйте: більшість позицій робимо під
      замовлення.
    </p>

    <ul class="grid">
      {products.map((product) => (
        <ProductCard product={product} image={imagesBySlug.get(product.slug)} />
      ))}
      <CustomOrderCard />
    </ul>

    <div class="price-note">
      <p>
        <strong>Прайс-листа немає.</strong> Вартість залежить від породи каменю,
        розміру виробу та типу обробки — тому ціну ми рахуємо індивідуально під
        ваше замовлення.
      </p>
      <a class="btn btn--primary" href={site.phone.href}>
        <Icon name="phone" size={18} />
        <span>Дізнатись вартість</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Колонки задані явно, а не через auto-fill: 8 категорій + картка
     «під замовлення» = 9 плиток, тобто рівні 3×3 на десктопі без порожніх
     клітинок. CustomOrderCard спирається на ці ж брейкпоінти — якщо міняєш
     їх тут, синхронізуй і там. */
  .grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    grid-template-columns: 1fr;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  @media (min-width: 620px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .price-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--c-white);
    border: 1px solid var(--c-line);
    border-left: 4px solid var(--c-accent);
    border-radius: var(--radius-lg);
  }

  .price-note p {
    margin: 0;
    max-width: 60ch;
    color: var(--c-text-muted);
  }

  .price-note strong {
    color: var(--c-text);
  }

  @media (max-width: 560px) {
    .price-note .btn {
      width: 100%;
    }
  }
</style>
