---
import { Image } from 'astro:assets';
import Icon from '~/components/Icon.astro';
import { HERO } from '~/data/hero';
import { CONTACTS, STATS } from '~/data/site';
---

<section class="container-page pt-28 pb-16 md:pt-36 md:pb-24 lg:pt-44 lg:pb-32">
	<div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
		<div class="lg:col-span-6 xl:col-span-5">
			<p class="eyebrow">{HERO.eyebrow}</p>

			<h1 class="mt-6 text-display font-bold text-balance">{HERO.title}</h1>

			<p class="mt-7 max-w-lg text-lead text-ink-muted text-pretty">{HERO.lead}</p>

			<div class="mt-10 flex flex-col gap-3 sm:flex-row">
				<a href="/catalog" class="btn btn-primary">
					Переглянути каталог
					<Icon name="arrow-right" class="h-4 w-4" />
				</a>
				<a href={CONTACTS.phoneHref} class="btn btn-outline">
					<Icon name="phone" class="h-4 w-4" />
					{CONTACTS.phone}
				</a>
			</div>

			<dl class="mt-14 grid grid-cols-3 gap-6 border-t border-line pt-8">
				{
					STATS.map((stat) => (
						<div>
							<dt class="sr-only">{stat.label}</dt>
							<dd>
								<span class="block text-3xl font-bold tracking-tight text-ink lg:text-4xl">
									{stat.value}
								</span>
								<span class="mt-1.5 block text-sm text-ink-muted">{stat.label}</span>
							</dd>
						</div>
					))
				}
			</dl>
		</div>

		<div class="lg:col-span-6 xl:col-span-7">
			<div class="relative">
				<Image
					src={HERO.image}
					alt={HERO.imageAlt}
					widths={[640, 900, 1280]}
					sizes="(max-width: 1024px) 100vw, 58vw"
					loading="eager"
					decoding="sync"
					fetchpriority="high"
					class="aspect-4/3 w-full object-cover lg:aspect-5/4"
				/>

				<!-- Offset second frame: gives the hero depth without a carousel. -->
				<div class="absolute -bottom-10 -left-10 hidden w-56 border-8 border-paper xl:block">
					<Image
						src={HERO.inset}
						alt={HERO.insetAlt}
						widths={[224, 448]}
						sizes="224px"
						loading="eager"
						class="aspect-square w-full object-cover"
					/>
				</div>
			</div>
		</div>
	</div>
</section>
