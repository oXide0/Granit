---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import Icon from './Icon.astro';
import heroImage from '../assets/production/rozpyl-kamenyu.jpeg';
---

<section class="hero">
  <Image
    class="hero__bg"
    src={heroImage}
    alt="Каменерізний верстат у цеху з розпилу природного каменю"
    widths={[640, 960, 1280]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="hero__place">
      <Icon name="pin" size={16} />
      <span>{site.address.district}, {site.address.region}</span>
    </p>

    <h1>Вироби з природного каменю</h1>

    <p class="hero__lead">
      Пам’ятники, стільниці, бруківка, облицювання, сходи та підвіконня — з власного
      цеху в Коростишівському районі. Виготовляємо готові вироби та працюємо під
      замовлення за вашими розмірами.
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary btn--lg" href={site.phone.href}>
        <Icon name="phone" size={20} />
        <span>{site.phone.display}</span>
      </a>
      <a class="btn btn--ghost btn--lg" href="#produkciya">
        Подивитись продукцію
        <Icon name="arrow-down" size={18} />
      </a>
    </div>

    <p class="hero__note">
      Ціни узгоджуємо по телефону — прайс залежить від каменю, розміру та обробки.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(520px, 78vh, 760px);
    color: var(--c-sand-100);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to right,
        rgba(14, 16, 18, 0.92) 0%,
        rgba(14, 16, 18, 0.78) 45%,
        rgba(14, 16, 18, 0.5) 100%
      );
  }

  .hero__inner {
    padding-block: clamp(3rem, 9vw, 5.5rem);
  }

  .hero__place {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.1rem;
    padding: 0.35rem 0.85rem 0.35rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #e6d7c2;
  }

  .hero h1 {
    max-width: 16ch;
    color: var(--c-white);
  }

  .hero__lead {
    max-width: 54ch;
    margin-bottom: 2rem;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: #d6d9dc;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero__note {
    margin: 1.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--c-dust);
  }

  @media (max-width: 520px) {
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
