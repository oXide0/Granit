---
import Icon from '~/components/Icon.astro';
import { CONTACTS } from '~/data/site';
---

<!-- Phone is how this business is actually contacted, so on mobile it stays
     within thumb reach at all times. Body has matching bottom padding. -->
<div
	class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-line bg-paper/95 backdrop-blur-xl md:hidden"
	style="padding-bottom: env(safe-area-inset-bottom)"
>
	<a
		href={CONTACTS.phoneHref}
		class="flex items-center justify-center gap-2 py-4 text-sm font-bold text-ink"
	>
		<Icon name="phone" class="h-4 w-4" />
		Подзвонити
	</a>
	<a
		href={CONTACTS.emailHref}
		class="flex items-center justify-center gap-2 border-l border-line bg-ink py-4 text-sm font-bold text-paper"
	>
		<Icon name="mail" class="h-4 w-4" />
		Написати
	</a>
</div>
