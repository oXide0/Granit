---
/** Fixed call button, mobile only. This is the primary conversion action. */
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<div class="callbar">
  <a class="callbar__link" href={site.phone.href}>
    <Icon name="phone" size={20} />
    <span>Зателефонувати {site.phone.display}</span>
  </a>
</div>

<style>
  .callbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    padding: 0.4rem 0.6rem calc(0.4rem + env(safe-area-inset-bottom));
    background: rgba(22, 24, 27, 0.95);
    backdrop-filter: blur(6px);
  }

  .callbar__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 50px;
    padding: 0.5rem 1rem;
    background: var(--c-accent);
    color: var(--c-white);
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .callbar__link:active {
    background: var(--c-accent-strong);
  }

  @media (min-width: 768px) {
    .callbar {
      display: none;
    }
  }
</style>
