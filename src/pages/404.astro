---
import Icon from '~/components/Icon.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
	title="Сторінку не знайдено"
	description="Такої сторінки не існує. Перейдіть на головну або до каталогу видів граніту."
	noindex
>
	<section class="container-page flex min-h-[70vh] flex-col justify-center py-28 md:py-36">
		<p class="eyebrow">Помилка 404</p>
		<h1 class="mt-6 max-w-3xl text-display font-bold text-balance">Такої сторінки немає</h1>
		<p class="mt-6 max-w-lg text-lead text-ink-muted text-pretty">
			Можливо, адресу введено з помилкою або сторінку було переміщено. Скористайтеся
			посиланнями нижче.
		</p>
		<div class="mt-10 flex flex-col gap-3 sm:flex-row">
			<a href="/" class="btn btn-primary">
				На головну
				<Icon name="arrow-right" class="h-4 w-4" />
			</a>
			<a href="/catalog" class="btn btn-outline">Каталог видів граніту</a>
		</div>
	</section>
</BaseLayout>
