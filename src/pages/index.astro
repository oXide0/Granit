---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Products from '../components/Products.astro';
import Production from '../components/Production.astro';
import CustomOrder from '../components/CustomOrder.astro';
import Location from '../components/Location.astro';
import Contact from '../components/Contact.astro';

const title =
  'Вироби з природного каменю — Житомирська область, Коростишівський район';
const description =
  'Пам’ятники, стільниці, бруківка, облицювальний камінь, сходи та підвіконня з природного каменю. Власне виробництво у с. Слобідка на Житомирщині, вироби під замовлення. Ціни — за телефоном.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <About />
  <Products />
  <Production />
  <CustomOrder />
  <Location />
  <Contact />
</BaseLayout>
